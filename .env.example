# Copy to .env.local and fill in what you need. Nothing here is required to run the site.

# Deployed origin, no trailing slash. Enables the canonical URL, social preview image and
# sitemap. Vercel's production domain is detected automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Formspree form ID (https://formspree.io). Without it the contact form opens an email draft.
NEXT_PUBLIC_FORMSPREE_ID=

# Used by the local project editor (npm run edit:projects) and the hidden experiments section.
# GITHUB_TOKEN is optional (raises the API rate limit) and needs read-only access to public
# repositories. Never prefix it with NEXT_PUBLIC_.
GITHUB_USERNAME=janudawithanage
GITHUB_TOKEN=
